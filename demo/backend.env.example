# Laravel en la DEMO. init-db.sh copia este archivo a demo/backend.env
# (ignorado por git) y genera APP_KEY. La conexión a la base (DB_*) la
# pone docker-compose.yml: usuario app_user, clave de demo/.env.

APP_NAME="Sistema Academico"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Placeholder: la URL del túnel cambia en cada arranque y la API no arma
# URLs absolutas con APP_URL (todo es JSON con rutas relativas).
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs a la salida del contenedor: docker compose logs app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Igual que en desarrollo (backend/.env). La caché vive en la tabla
# `cache` (migración de Laravel) y guarda los contadores del límite de
# intentos del login.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Tokens de 12 h (config/sanctum.php).
SANCTUM_EXPIRATION=720

# Confía en X-Forwarded-Proto/Host que pone nginx (ver bootstrap/app.php).
# Solo nginx llega a php-fpm, así que "*" no abre nada.
TRUSTED_PROXIES=*
